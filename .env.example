# ==============================================================================
# Environment Configuration Template for Mastering LangChain and LangGraph
# Copy this file to .env and insert your actual API keys:
#   cp .env.example .env
# ==============================================================================

# LLM Provider API Keys
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"
MISTRAL_API_KEY="your-mistral-api-key"
GROQ_API_KEY="your-groq-api-key"
HUGGINGFACEHUB_API_TOKEN="your-huggingface-token"

# LangSmith Tracing & Observability (LangChain)
LANGCHAIN_API_KEY="your-langchain-api-key"
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="mastering-langchain-langgraph"

# Search & Tool APIs
TAVILY_API_KEY="your-tavily-api-key"
